rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All Firestore access is mediated strictly through serverless backend APIs
    // utilizing Firebase Admin SDK with server-side authentication and authorization.
    // Direct client-side access is completely disallowed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
